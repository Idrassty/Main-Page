rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    // true if fid is an accepted friendship that includes the signed-in user
    function accepted(fid) {
      let f = get(/databases/$(db)/documents/friendships/$(fid)).data;
      return request.auth != null && f.status == 'accepted' && request.auth.uid in f.users;
    }

    match /usernames/{name} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
    }

    match /users/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth.uid == uid;

      // push notification device tokens: only the owner
      match /tokens/{t} {
        allow read, write: if request.auth.uid == uid;
      }

      // PRIVATE DIARY: only the owner
      match /diary/{id} {
        allow read, write: if request.auth.uid == uid;
      }
    }

    match /friendships/{fid} {
      allow get: if request.auth != null
                 && (resource == null || request.auth.uid in resource.data.users);
      allow list: if request.auth.uid in resource.data.users;
      allow create: if request.auth.uid in request.resource.data.users
                    && request.resource.data.from == request.auth.uid
                    && request.resource.data.status == 'pending';
      allow update: if request.auth.uid in resource.data.users
                    && resource.data.from != request.auth.uid
                    && request.resource.data.users == resource.data.users;
      allow delete: if request.auth.uid in resource.data.users;

      match /messages/{mid} {
        allow read: if accepted(fid);
        allow create: if accepted(fid) && request.resource.data.from == request.auth.uid;
      }

      // Calls (signaling only; audio/video goes directly between the two phones)
      match /calls/{cid} {
        allow read, write: if accepted(fid);
        match /{sub}/{doc} {
          allow read, write: if accepted(fid);
        }
      }
    }
  }
}
